BOT_TOKEN=123456:ABCDEF

# OpenAI-compatible endpoint (Timeweb Agent / OpenAI / etc)
#
# Timeweb Agent ID (agent_access_id from the dashboard)
AI_AGENT_ID=<agent_id>
AI_API_KEY=your_timeweb_token_here
AI_MODEL=gpt-4.1

# Storage
DB_PATH=./ai_eng_bot/data/database.db
STATS_PATH=./ai_eng_bot/data/stats.txt

# History retention / privacy
HISTORY_TTL_DAYS=90

# Context window (messages to send to LLM)
LLM_CONTEXT_MESSAGES=10

# Timeouts / retries
LLM_REQUEST_TIMEOUT_S=30
LLM_MAX_RETRIES=3
LLM_JSON_MODE=true

# Anti-spam (simple in-memory limiter)
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX_MESSAGES=20

# Admins (Telegram user IDs, comma-separated)
ADMIN_IDS=123456789,987654321
